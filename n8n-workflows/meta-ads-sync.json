    {
      "id": "node_set_constants",
      "name": "Set Constants",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "const_api_version",
              "name": "META_ADS_API_VERSION",
              "value": "v24.0",
              "type": "string"
            },
            {
              "id": "const_backfill_days",
              "name": "BACKFILL_DAYS",
              "value": 90,
              "type": "number"
            },
            {
              "id": "const_incremental_days",
              "name": "INCREMENTAL_DAYS",
              "value": 2,
              "type": "number"
            },
            {
              "id": "const_supabase_url",
              "name": "SUPABASE_URL",
              "value": "https://rvkkvjitfddtbdpkupok.supabase.co",
              "type": "string"
            },
            {
              "id": "const_attribution_windows",
              "name": "ATTRIBUTION_WINDOWS_JSON",
              "value": "[\"7d_click\",\"1d_view\"]",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node_list_accounts",
      "name": "List active Meta Ads accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/ad_accounts?channel=eq.meta_ads&active=eq.true&select=id,tenant_id,account_id,vault_secret_id,tenants(slug)",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_loop_tenants",
      "name": "Loop tenants",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [900, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node_check_first_sync",
      "name": "Check first sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/sync_jobs?tenant_id=eq.{{ $json.tenant_id }}&channel=eq.meta_ads&status=eq.success&select=id&limit=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_compute_date_range",
      "name": "Compute date range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300],
      "parameters": {
        "jsCode": "const today = new Date();\nconst prevJobs = $('Check first sync').item.json;\nconst isFirstSync = !Array.isArray(prevJobs) || prevJobs.length === 0;\nconst days = isFirstSync ? $('Set Constants').first().json.BACKFILL_DAYS : $('Set Constants').first().json.INCREMENTAL_DAYS;\nconst from = new Date(today);\nfrom.setDate(today.getDate() - days);\n// Meta requer 'act_' prefix em ad_account_id\nconst rawAcc = $('Loop tenants').item.json.account_id;\nconst ad_account_id = String(rawAcc).startsWith('act_') ? rawAcc : `act_${rawAcc}`;\nreturn [{ json: {\n  tenant_id: $('Loop tenants').item.json.tenant_id,\n  ad_account_id,\n  tenant_slug: $('Loop tenants').item.json.tenants?.slug,\n  date_from: from.toISOString().split('T')[0],\n  date_to: today.toISOString().split('T')[0],\n  is_first_sync: isFirstSync\n}}];"
      }
    },
    {
      "id": "node_open_sync_job",
      "name": "Open sync_job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/sync_jobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"tenant_id\": \"{{ $json.tenant_id }}\",\n  \"channel\": \"meta_ads\",\n  \"status\": \"running\",\n  \"date_from\": \"{{ $json.date_from }}\",\n  \"date_to\": \"{{ $json.date_to }}\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_read_vault_secret",
      "name": "Read vault secret",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/rpc/read_vault_secret",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"p_secret_name\": \"tenant_{{ $('Compute date range').item.json.tenant_slug }}_meta_system_token\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_init_pagination",
      "name": "Init pagination cursor",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 300],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign_next_url",
              "name": "next_url",
              "value": "=https://graph.facebook.com/{{ $('Set Constants').item.json.META_ADS_API_VERSION }}/{{ $('Compute date range').item.json.ad_account_id }}/insights?level=campaign&fields=campaign_id,campaign_name,impressions,clicks,spend,actions,action_values,adset_id,date_start,date_stop&time_range={\"since\":\"{{ $('Compute date range').item.json.date_from }}\",\"until\":\"{{ $('Compute date range').item.json.date_to }}\"}&time_increment=1&action_attribution_windows={{ $('Set Constants').item.json.ATTRIBUTION_WINDOWS_JSON }}&limit=100&access_token={{ $('Read vault secret').item.json }}",
              "type": "string"
            },
            {
              "id": "assign_all_rows",
              "name": "all_rows",
              "value": "=[]",
              "type": "array"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node_meta_insights_paged",
      "name": "Meta Insights paged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Init pagination cursor').item.json.next_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "node_accumulate_page",
      "name": "Accumulate page + extract next",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 300],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst rows = $('Init pagination cursor').first().json.all_rows || [];\nfor (const d of (resp.data || [])) {\n  rows.push(d);\n}\nconst next = resp.paging?.next || null;\nreturn [{ json: { all_rows: rows, next_url: next, has_more: !!next } }];"
      }
    },
    {
      "id": "node_more_pages",
      "name": "More pages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2660, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_has_more",
              "leftValue": "={{ $json.has_more }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "node_map_results",
      "name": "Map Meta results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2880, 300],
      "parameters": {
        "jsCode": "function extractActionValue(actionsArray, actionType) {\n  if (!Array.isArray(actionsArray)) return 0;\n  const action = actionsArray.find(a => a.action_type === actionType);\n  return action ? parseFloat(action.value) : 0;\n}\nconst tenantId = $('Compute date range').item.json.tenant_id;\nconst all = $('Accumulate page + extract next').first().json.all_rows;\nreturn all.map(d => ({ json: {\n  tenant_id: tenantId,\n  campaign_id: d.campaign_id,\n  campaign_name: d.campaign_name,\n  channel: 'meta_ads',\n  date: d.date_start,\n  impressions: parseInt(d.impressions || '0'),\n  clicks: parseInt(d.clicks || '0'),\n  spend: parseFloat(d.spend || '0'),\n  conversions: extractActionValue(d.actions, 'purchase'),\n  conversion_value: extractActionValue(d.action_values, 'purchase'),\n  status: null,\n  ad_group_id: d.adset_id || null,\n  attribution_window: '7d_click',\n  synced_at: new Date().toISOString()\n}}));"
      }
    },
    {
      "id": "node_upsert_metrics",
      "name": "Upsert campaign_metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3100, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/campaign_metrics?on_conflict=tenant_id,campaign_id,channel,date",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ $('Map Meta results').all().map(i => i.json) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
