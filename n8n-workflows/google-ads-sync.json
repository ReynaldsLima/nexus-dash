        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"p_secret_name\": \"tenant_{{ $('Compute date range').item.json.tenant_slug }}_google_refresh_token\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_exchange_token",
      "name": "Exchange refresh for access token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300],
      "parameters": {
        "method": "POST",
        "url": "https://oauth2.googleapis.com/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "refresh_token"
            },
            {
              "name": "client_id",
              "value": "={{ $credentials.googleOAuthCredentials.clientId }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $credentials.googleOAuthCredentials.clientSecret }}"
            },
            {
              "name": "refresh_token",
              "value": "={{ $('Read vault secret').item.json }}"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "credentials": {
          "oAuth2Api": {
            "id": "google_oauth_credentials",
            "name": "Google OAuth Credentials"
          }
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "google_oauth_credentials",
          "name": "Google OAuth Credentials"
        }
      }
    },
    {
      "id": "node_search_stream",
      "name": "Google Ads SearchStream",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 300],
      "parameters": {
        "method": "POST",
        "url": "=https://googleads.googleapis.com/{{ $('Set Constants').item.json.GOOGLE_ADS_API_VERSION }}/customers/{{ $('Compute date range').item.json.account_id }}/googleAds:searchStream",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Exchange refresh for access token').item.json.access_token }}"
            },
            {
              "name": "developer-token",
              "value": "={{ $credentials.googleAdsDevToken.token }}"
            },
            {
              "name": "login-customer-id",
              "value": "={{ $credentials.googleAdsDevToken.managerId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"query\": \"SELECT campaign.id, campaign.name, campaign.status, metrics.impressions, metrics.clicks, metrics.cost_micros, metrics.conversions, metrics.conversions_value, segments.date, ad_group.id FROM campaign WHERE segments.date BETWEEN '{{ $('Compute date range').item.json.date_from }}' AND '{{ $('Compute date range').item.json.date_to }}' AND campaign.status != 'REMOVED' ORDER BY segments.date ASC\"\n}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "google_ads_dev_token",
            "name": "Google Ads Dev Token"
          }
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "google_ads_dev_token",
          "name": "Google Ads Dev Token"
        }
      }
    },
    {
      "id": "node_map_results",
      "name": "Map Google Ads results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 300],
      "parameters": {
        "jsCode": "const tenantId = $('Compute date range').item.json.tenant_id;\nconst rows = [];\nfor (const chunk of $input.all()) {\n  const results = chunk.json.results || [];\n  for (const result of results) {\n    const campaign = result.campaign || {};\n    const metrics = result.metrics || {};\n    const segments = result.segments || {};\n    rows.push({\n      tenant_id: tenantId,\n      campaign_id: campaign.id,\n      campaign_name: campaign.name,\n      channel: 'google_ads',\n      date: segments.date,\n      impressions: parseInt(metrics.impressions || '0'),\n      clicks: parseInt(metrics.clicks || '0'),\n      spend: parseInt(metrics.costMicros || '0') / 1_000_000,\n      conversions: parseFloat(metrics.conversions || '0'),\n      conversion_value: parseFloat(metrics.conversionsValue || '0'),\n      status: campaign.status,\n      ad_group_id: result.adGroup?.id || null,\n      attribution_window: '7d_click',\n      synced_at: new Date().toISOString()\n    });\n  }\n}\nreturn rows.map(row => ({ json: row }));"
      }
    },
