    },
    {
      "id": "node_close_sync_success",
      "name": "Close sync_job (success)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3100, 300],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/sync_jobs?id=eq.{{ $('Open sync_job').item.json[0].id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"status\": \"success\",\n  \"completed_at\": \"{{ $now.toISO() }}\",\n  \"records_synced\": {{ $('Map Google Ads results').all().length }}\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_error_handler",
      "name": "Handle tenant error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 540],
      "parameters": {
        "jsCode": "// Sanitize error message to prevent token leakage (Threat T-2-03-06)\nconst rawError = $input.item.json.error?.message || $input.item.json.message || 'Unknown error';\nconst sanitized = rawError.replace(/Bearer [A-Za-z0-9._\\-]+/g, 'Bearer ***');\nreturn [{ json: {\n  sync_job_id: $('Open sync_job').item.json?.[0]?.id,\n  error_message: sanitized\n}}];"
      }
    },
    {
      "id": "node_close_sync_failed",
      "name": "Close sync_job (failed)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 540],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/sync_jobs?id=eq.{{ $('Handle tenant error').item.json.sync_job_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"status\": \"failed\",\n  \"completed_at\": \"{{ $now.toISO() }}\",\n  \"error_message\": \"{{ $('Handle tenant error').item.json.error_message }}\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    }
