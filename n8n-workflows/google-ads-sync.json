      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/sync_jobs?tenant_id=eq.{{ $json.tenant_id }}&channel=eq.google_ads&status=eq.success&select=id&limit=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "id": "node_compute_date_range",
      "name": "Compute date range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 300],
      "parameters": {
        "jsCode": "const today = new Date();\nconst prevJobs = $('Check first sync').item.json;\nconst isFirstSync = !Array.isArray(prevJobs) || prevJobs.length === 0;\nconst days = isFirstSync ? $('Set Constants').first().json.BACKFILL_DAYS : $('Set Constants').first().json.INCREMENTAL_DAYS;\nconst from = new Date(today);\nfrom.setDate(today.getDate() - days);\nreturn [{ json: {\n  tenant_id: $('Loop tenants').item.json.tenant_id,\n  account_id: $('Loop tenants').item.json.account_id,\n  vault_secret_id: $('Loop tenants').item.json.vault_secret_id,\n  tenant_slug: $('Loop tenants').item.json.tenants?.slug,\n  date_from: from.toISOString().split('T')[0],\n  date_to: today.toISOString().split('T')[0],\n  is_first_sync: isFirstSync\n}}];"
      }
    },
    {
      "id": "node_open_sync_job",
      "name": "Open sync_job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/sync_jobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "credentials": {
          "httpHeaderAuth": {
            "id": "supabase_service_role",
            "name": "Supabase Service Role"
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"tenant_id\": \"{{ $json.tenant_id }}\",\n  \"channel\": \"google_ads\",\n  \"status\": \"running\",\n  \"date_from\": \"{{ $json.date_from }}\",\n  \"date_to\": \"{{ $json.date_to }}\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase_service_role",
          "name": "Supabase Service Role"
        }
      }
    },
