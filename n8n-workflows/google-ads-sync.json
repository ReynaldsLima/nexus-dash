      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Constants').item.json.SUPABASE_URL }}/rest/v1/rpc/read_vault_secret",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
