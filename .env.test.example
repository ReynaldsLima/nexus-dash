# Copy to .env.test.local — never commit the .local version
# These point at the Supabase staging schema for integration tests.
SUPABASE_TEST_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_TEST_SERVICE_KEY=<SERVICE_ROLE_KEY>
SUPABASE_TEST_ANON_KEY=<ANON_KEY>

# Google Ads OAuth2 (Phase 7 / SET-01) — fake test values, tests set their own via beforeEach
GOOGLE_OAUTH_STATE_SECRET=test-secret-32-bytes-minimum-abcdef
GOOGLE_ADS_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=test-client-secret
